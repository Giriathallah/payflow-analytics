<clickhouse>
  <!-- Docs: <https://clickhouse.com/docs/en/operations/settings/settings_users/> -->
  <users>
    <!-- Remove default user -->
    <default remove="remove">
    </default>

    <clickhouse_admin>
      <profile>default</profile>
      <networks>
        <ip>::/0</ip>
      </networks>
      <password><![CDATA[clickhouse_admin_pass]]></password>
      <quota>default</quota>
      <access_management>1</access_management>
    </clickhouse_admin>

    <superset_reader>
      <profile>default</profile>
      <networks>
        <ip>::/0</ip>
      </networks>
      <password><![CDATA[superset_reader_pass]]></password>
      <quota>default</quota>
    </superset_reader>
  </users>
</clickhouse>
